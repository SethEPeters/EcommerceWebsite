<nav class="navbar navbar-expand-lg  navbar-light bg-light nav-nav">
  <a class="navbar-brand" href="http://localhost:3000/items">CD-Vinyl Records</a>
  <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
    <span class="navbar-toggler-icon"></span>
  </button>
  <div class="d-flex justify-content-between collapse navbar-collapse nav-div" id="navbarSupportedContent">
    <ul class="navbar-nav mr-auto">
      <li class="nav-item">
        <a class="nav-link" href="http://localhost:3000/abouts/1">about</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="http://localhost:3000/contacts">contact</a>
      </li>
    </ul>
    <ul class="navbar-nav mr-auto">
    <% if user_signed_in? %>
      <li class="nav-item">
        <a class="nav-link" href="http://localhost:3000/orders">view orders</a>
      </li>
      <li class="nav-item">
      <%= link_to "log out", destroy_user_session_path, class: "nav-link", data: { turbo_method: :delete } %>
      </li>
      <li class="nav-item">
        <p class="navbar-text" >Welcome back, <%= current_user.email %>!</p>
      </li>
      <% else %>
        <li class="nav-item">
          <a class="nav-link" href="http://localhost:3000/users/sign_up">sign up</a>
        </li>
