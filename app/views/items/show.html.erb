<div id="item">
    <p><%= @item.title %></p>
    <p><%= @item.description %></p>
    <p><%= @item.artist %></p>
    <p><%= @item.price %></p>
    <p><%= @item.quantity %></p>
    <p><%= @item.category_id %></p>
    <% if @item.item_image_path.attached? %>
      <%= image_tag(@item.item_image_path, width: '200px') %>
    <% end %>
</div>

<div>
  <%= link_to "Back to items", items_path %>
</div>
