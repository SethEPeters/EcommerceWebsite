<div id="<%= dom_id item %>">
  <div>
    <strong>Title:</strong>
    <%= item.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= item.description %>
  </div>

  <div>
    <strong>Item image path:</strong>
    <%= item.item_image_path %>
  </div>

  <div>
    <strong>Artist:</strong>
    <%= item.artist %>
  </div>

  <div>
    <strong>Price:</strong>
    <%= item.price %>
  </div>

  <div>
    <strong>Quantity:</strong>
    <%= item.quantity %>
  </div>

</div>
