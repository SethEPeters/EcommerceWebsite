
<a href="items/<%= item.id %>">
  <div id="items">
    <strong><%= item.title %></strong>
    <p><%= item.description %></p>
    <p><%= item.artist %></p>
    <p><%= number_to_currency( item.price ) %></p>
    <p>Quantity: <%= item.quantity %></p>
    <% if item.item_image_path.attached? %>
      <%= image_tag item.item_image_path, width: "200" %>
    <% end %>
  </div>
</a>