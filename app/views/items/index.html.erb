<div class="container text-left">
  <div class="row search-row">
    <div class="nav-search-div">
      <%= form_with items_path: "/search", method: :get do |f| %>
        <%= f.label :search, "Search" %>
        <%= text_field_tag :search, params[:search] %>
        <%= f.label :category_id, "Select Category" %>
        <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "No Category" } %>
        <%= submit_tag "Search", :name => nil, class: "search-button" %>
      <% end %>
    </div>
  </div>
  <div class="row">
    <div class="col side-nav">
      <ul>
        <li><strong>Categories</strong></li>
        <% @categories.each do |category| %>
          <a href=items?category_id=<%=category.id%>><li><%=category.name%></li></a>
        <%end%>
        <li><strong>Filter</strong></li>
        <a href=items?filter=1><li>New</li></a>
        <a href=items?filter=2><li>Recently Updated</li></a>
      </ul>
    </div>
    <div class="col-10">
      <%= paginate @items%>
      <% @items.each do |item| %>
        <%= render "item", item: item %>
      <% end %>
      <%= paginate @items %>
    </div>
  </div>
</div>
