<div class="container text-center">
  <div class="row">
    <div class="col-2">
      <h1> CD-Vinyl Records</h1>
    </div>
    <div class="col">
      <a href="abouts/1"><p>about</p></a>
    </div>
    <div class="col">
      <a href="contacts"><p>contact</p></a>
    </div>
    <div class="col">
      <a href="orders">view orders</a>
    </div>
    <div class="col">
    </div>
    <div class="col-4">
      <%= form_with items_path: "/search", method: :get do |f| %>
        <%= text_field_tag :search, params[:search] %>
        <%= f.label :category_id, "Select Category" %>
        <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "No Category" } %>
        <%= submit_tag "Search", :name => nil %>
      <% end %>
    </div>
    <div class="col">
    </div>
    <% if user_signed_in? %>
      <div class="col">
        <%= link_to "log out", destroy_user_session_path, data: { turbo_method: :delete } %>
      </div>
    <% else %>
      <div class="col">
        <a href="users/sign_up">sign up</a>
      </div>
      <div class="col">
        <a href="users/sign_in">log in</a>
      </div>
     <% end %>
    <% if user_signed_in? %>
      <div class="col">
        <p>Welcome back, <%= current_user.email %>!</p>
      </div>
    <% end %>
  </div>
</div>

<div class="container text-left">
  <div class="row">
    <div class="col">
      <ul>
        <% @categories.each do |category| %>
          <a href=items?category_id=<%=category.id%>><li><%=category.name%></li></a>
        <%end%>
      </ul>
    </div>
    <div class="col-10">
      <ul>
        <a href=items?filter=1><li>New</li></a>
        <a href=items?filter=2><li>Recently Updated</li></a>
      </ul>
      <%= paginate @items%>
      <% @items.each do |item| %>
        <%= render "item", item: item %>
      <% end %>
      <%= paginate @items%>
    </div>
  </div>
</div>
