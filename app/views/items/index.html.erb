<p style="color: green"><%= notice %></p>

<% content_for :title, "Items" %>

<nav>
  <a href="abouts/1"><p>about</p></a>
  <a href="contacts"><p>contact</p></a>
</nav>

<h1>Items</h1>

<%= form_with items_path: "/search", method: :get do |f| %>
  <%= text_field_tag :search, params[:search] %>
  <%= f.label :category_id, "Select Category" %>
  <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "No Category" } %>
  <%= submit_tag "Search", :name => nil %>
<% end %>

<% @items.each do |item| %>
  <%= render "item", item: item %>
<% end %>

<%= paginate @items%>
