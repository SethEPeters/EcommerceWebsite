<p style="color: green"><%= notice %></p>

<% content_for :title, "Items" %>

<h1>Items</h1>

<div id="items">
  <% @items.each do |item| %>
    <p><%= item.title %></p>
    <p><%= item.description %></p>
    <p><%= item.artist %></p>
    <p><%= item.price %></p>
    <p><%= item.quantity %></p>
    <% if item.item_image_path.attached? %>
      <%= image_tag(item.item_image_path, width: '200px') %>
    <% end %>
    <p><%= link_to "Show this item", item %></p>
  <% end %>
</div>

<%= paginate @items%>
