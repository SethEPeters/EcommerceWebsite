<div class="row invoice-row">
  <div class="col">
    <h1 class="invoice-title">Thank you for your order!</h1>
    <hr>
    <h2 class="invoice-name"> Delivering to <%= @order.first_name %> <%= @order.last_name %></h2>
    <p> Total before tax <%= number_to_currency(@order.order_total_at_purchase / (1 + (ProvinceTax.find(@order.province_tax.id).gst / 100) + (ProvinceTax.find(@order.province_tax.id).pst / 100) +(ProvinceTax.find(@order.province_tax.id).hst / 100))) %></p>
    <p> + GST @ <%= ProvinceTax.find(@order.province_tax.id).gst%>% <%= number_to_currency((@order.order_total_at_purchase / (1 + (ProvinceTax.find(@order.province_tax.id).gst / 100) + (ProvinceTax.find(@order.province_tax.id).pst / 100) + (ProvinceTax.find(@order.province_tax.id).hst / 100))) * (ProvinceTax.find(@order.province_tax.id).gst / 100)) %></p>
    <p> + PST @ <%= ProvinceTax.find(@order.province_tax.id).pst%>% <%= number_to_currency((@order.order_total_at_purchase / (1 + (ProvinceTax.find(@order.province_tax.id).gst / 100) + (ProvinceTax.find(@order.province_tax.id).pst / 100) + (ProvinceTax.find(@order.province_tax.id).hst / 100))) * (ProvinceTax.find(@order.province_tax.id).pst / 100)) %></p>
    <p> + HST @ <%= ProvinceTax.find(@order.province_tax.id).hst%>% <%= number_to_currency((@order.order_total_at_purchase / (1 + (ProvinceTax.find(@order.province_tax.id).gst / 100) + (ProvinceTax.find(@order.province_tax.id).pst / 100) + (ProvinceTax.find(@order.province_tax.id).hst / 100))) * (ProvinceTax.find(@order.province_tax.id).hst / 100)) %></p>
    <strong> Total Price <%= @order.order_total_at_purchase %></strong>
    <p> Ordered at <%= @order.date_of_purchase %></p>
    <p> Delivering to <%= @order.delivery_address %></p>
    <ol>
      <% @order.line_items.each do |item| %>
        <li><%= item.quantity %> x <%= item.item.title %></li>
      <% end %>
    </ol>
    <%= button_to "Cancel Order", @order, method: :delete %>
  </div>
</div>
