<div class="row information-fillout-row">
    <strong>SubTotal: <%= number_to_currency(@current_cart.sub_total) %> </strong>
    <hr>
    <%= form_for(@order) do |f| %>
      <p>
        <%= label_tag :first_name %>
        <%= text_field_tag :first_name, nil, required: true, autofocus: true %>
      </p>
      <p>
        <%= label_tag :last_name %>
        <%= text_field_tag :last_name, nil, required: true%>
      </p>
      <p>
        <%= label_tag :email %>
        <%= email_field_tag :email, nil, required: true %>
      </p>
      <p>
        <%= label_tag :delivery_address %>
        <%= text_field_tag :delivery_address, nil, required: true %>
      </p>
      <p>
        <%= label_tag :province_tax, "Province" %>
        <%= f.collection_select :province_tax_id, ProvinceTax.all, :id, :province, { prompt: "Select Your Province" } %>
      </p>
      <p>
        <%= f.submit "Proceed", class:"proceed-button" %>
      </p>
    <% end %>
</div>
