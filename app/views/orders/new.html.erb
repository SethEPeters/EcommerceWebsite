<h1>Orders#new</h1>

<%= form_for(@order) do |f| %>
  <p>
    <%= f.label :name %><br>
    <%= f.text_field :name, required: true, autofocus: true %>
  </p>
  <p>
    <%= f.label :email %><br>
    <%= f.email_field :email %>
  </p>
  <p>
    <%= f.label :delivery_address %><br>
    <%= f.text_area :delivery_address %>
  </p>
  <p>
    <%= f.label :province_tax %><br>
    <%= f.collection_select :province_tax_id, ProvinceTax.all, :id, :province, { prompt: "Select Your Province" } %>
  </p>
  <p>
    <%= f.submit %>
  </p>
<% end %>
